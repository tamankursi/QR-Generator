# ==============================================================================
# ENVIRONMENT VARIABLES: QR Code Generator dengan Aktivasi PIN
# ==============================================================================

# SUPABASE CONFIGURATION
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# SERVICE ROLE KEY (SERVER-SIDE ONLY - JANGAN PERNAH EXPOSE KE BROWSER / CLIENT)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# PIN AKTIVASI & EDIT LINK (SERVER-SIDE ONLY - RAHASIA PRIBADI)
# Default sesuai spesifikasi PRD: 140405
ACTIVATION_PIN="140405"

# BASE URL HOSTING (untuk format link QR: {BASE_URL}/q/{id})
# Contoh di Vercel: https://my-qr-app.vercel.app
# Di local: http://localhost:3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# SERVER PORT
PORT=3000
